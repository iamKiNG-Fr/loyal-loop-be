{
  "name": "loyal-loop-be",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:pg": "ts-node scripts/deploy-migrations.ts",
    "prisma:push": "prisma db push",
    "seed": "ts-node scripts/seed.ts",
    "bootstrap:superadmin": "ts-node scripts/bootstrap-superadmin.ts",
    "db:setup": "npm run prisma:deploy:pg && npm run seed",
    "check:isolated": "node scripts/check-isolated-profile.mjs",
    "verify:isolated-core": "npm run check:isolated && node scripts/verify-isolated-core-flow.mjs",
    "start:isolated": "npm run check:isolated && node --env-file=.env.isolated.local ./dist/main.js",
    "start:dev:isolated": "npm run check:isolated && node --env-file=.env.isolated.local ./node_modules/ts-node/dist/bin.js src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node ./dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "reminders:cron": "node scripts/run-reminder-cron.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "nanoid": "^3.3.8",
    "pg": "^8.21.0",
    "redis": "^6.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.1.9",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "hono": "4.12.27",
    "multer": "2.2.0"
  }
}
