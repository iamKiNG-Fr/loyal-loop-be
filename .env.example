PORT=5000
NODE_ENV=development
DB_USER=postgres
DB_PASS=password
DB_NAME=loyalloop
DB_HOST=localhost
DATABASE_URL=postgresql://postgres:password@localhost:5432/loyalloop?schema=public
# local, isolated, shared, or production. Never label shared data as isolated.
DATABASE_SAFETY_MODE=local
DB_SYNC=true
DB_LOGGING=false
CORS_ORIGINS=https://useloyalloop.com,https://www.useloyalloop.com,http://localhost:3000
TRUST_PROXY=1
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SESSION_HASH_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-separate-long-random-secret
ANALYTICS_HMAC_SECRET=replace-with-a-separate-long-random-secret
# Keep false for the coordinated backend/frontend rollout. Turn true as soon as
# the updated frontend and backend are both healthy.
CSRF_ENFORCED=false
OWNER_SESSION_DAYS=30
OWNER_ONBOARDING_PHONE_PROOF_MINUTES=30
OWNER_PHONE_CHANGE_PROOF_MINUTES=30
CUSTOMER_SESSION_DAYS=90
APP_URL=https://www.useloyalloop.com

# Founding Circle and platform-admin rollout.
#
# Keep both feature flags false while deploying the additive migration. Enable
# ADMIN_PORTAL_ENABLED only after the schema is current and the first SUPERADMIN
# has been created with `npm run bootstrap:superadmin -- --email=...`.
ADMIN_PORTAL_ENABLED=false
ADMIN_ORIGINS=https://admin.useloyalloop.com
ADMIN_ORIGIN_ENFORCED=false
ADMIN_PASSKEY_ENABLED=false
ADMIN_PASSKEY_REQUIRED=false
ADMIN_WHATSAPP_FALLBACK_ENABLED=true
ADMIN_WEBAUTHN_RP_ID=admin.useloyalloop.com
ADMIN_WEBAUTHN_ORIGINS=https://admin.useloyalloop.com

# A shared Redis-backed throttle is recommended before scaling the API beyond
# one instance. Keep disabled until REDIS_URL is configured and reachable.
RATE_LIMIT_REDIS_ENABLED=false
REDIS_URL=

# Signed Explore event tokens bind analytics to feed-issued results. Deploy the
# updated frontend before requiring tokens from every client.
DISCOVERY_SIGNED_EVENTS_REQUIRED=false

# When true, POST /auth/register requires a valid Founding Circle onboarding
# grant. Existing owners can still log in normally. Enable only after the
# homepage, /join flow, invitations, and support/monitoring are ready.
FOUNDING_ACCESS_REQUIRED=false

# Server-only HMAC secret used to sign the short-lived onboarding-grant cookie.
# Use an independent cryptographically random value of at least 32 bytes.
# Rotating it immediately invalidates every active onboarding grant.
FOUNDING_GRANT_SECRET=replace-with-a-separate-long-random-secret

# Server-only HMAC secret used to store invitation codes as keyed hashes rather
# than readable codes. Do not reuse SESSION_HASH_SECRET or FOUNDING_GRANT_SECRET.
# Rotating it makes every still-unredeemed invitation code fail validation.
FOUNDING_INVITATION_HASH_SECRET=replace-with-a-separate-long-random-secret

# Server-only secret used to derive the AES-256-GCM key that temporarily encrypts
# an invitation token while its WhatsApp message is queued. The encrypted token
# is cleared after delivery, suppression, terminal failure, revocation, or
# clipboard-only creation. Rotating this while messages are queued prevents
# those queued invitations from being sent; replace the affected invitations.
FOUNDING_INVITATION_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

FOUNDER_NAME=Francis King
EMAIL_FROM=Francis King <francis@mail.useloyalloop.com>
EMAIL_REPLY_TO=support@useloyalloop.com
EMAIL_FOUNDER_IMAGE_URL=
EMAIL_LOGO_URL=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Catalog media assessment. Keep moderation off until a provider is configured and
# verified; use shadow mode to inspect decisions before enforcing them publicly.
MEDIA_QUALITY_ANALYSIS_ENABLED=false
MEDIA_MODERATION_MODE=off
MEDIA_MODERATION_PROVIDER=aws_rek
CLOUDINARY_NOTIFICATION_URL=https://api.useloyalloop.com/api/v1/media/webhooks/cloudinary
# Twilio WhatsApp runtime. Allowed values: sandbox | production.
TWILIO_WHATSAPP_MODE=sandbox

# Shared Twilio credentials. Keep these in the backend secret store only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A. Development with the Twilio WhatsApp Sandbox.
# Every test recipient must first send the join phrase shown in Twilio Console.
# Then list joined E.164 numbers here, separated by commas (no whatsapp: prefix).
TWILIO_WHATSAPP_SANDBOX_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_SANDBOX_JOINED_NUMBERS=
# Keep false locally and after the registered production sender is activated. A
# production-built pre-launch service may explicitly set this to true for testing.
TWILIO_WHATSAPP_ALLOW_DEPLOYED_SANDBOX=false

# B. Production with the registered Loyal Loop WhatsApp sender.
TWILIO_WHATSAPP_SENDER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
# Approved twilio/media receipt template. Its media URL is variable {{5}}.
TWILIO_RECEIPT_MEDIA_CONTENT_SID=
TWILIO_DELIVERY_CONTENT_SID=
TWILIO_REMINDER_CONTENT_SID=
# Approved utility template for the owner morning digest. Variables are:
# {{1}} owner name, {{2}} business name, {{3}} task summary, {{4}} Today URL.
TWILIO_OWNER_DIGEST_CONTENT_SID=

# Approved Twilio Content template SID (normally starts with HX) for automatic
# Founding Circle invitation delivery in production. Leave empty when automatic
# delivery is disabled or while using the development Sandbox; clipboard and
# prepared-WhatsApp invitation options do not depend on this value.
    TWILIO_FOUNDING_ACCESS_CONTENT_SID=

# Shared safety, callback, and private-pilot controls.
TWILIO_WHATSAPP_VERIFY_ENABLED=false
TWILIO_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_KILL_SWITCH=true
TWILIO_WHATSAPP_PRODUCTION_READY=false
TWILIO_WHATSAPP_PILOT_ALLOWLIST=
TWILIO_WHATSAPP_WEBHOOK_URL=https://api.useloyalloop.com/api/v1/messaging/webhooks/twilio
TWILIO_WHATSAPP_DAILY_SEND_CAP=25
TWILIO_WHATSAPP_MAX_ATTEMPTS=4
# Optional dedicated secret; SESSION_HASH_SECRET is the fallback.
RECEIPT_MEDIA_SIGNING_SECRET=
MESSAGING_WORKER_SECRET=

# Owner attention scheduler. Generate independent random values for the two
# secrets. The cron service calls the deployed API; the API never self-schedules.
REMINDER_SCHEDULER_SECRET=
REMINDER_CRON_API_URL=https://api.useloyalloop.com
REMINDER_CRON_PROCESS_MESSAGES=false

# Web Push. Generate the key pair once with `node scripts/generate-vapid-keys.mjs`
# and keep the private value server-only. Example subject: mailto:support@useloyalloop.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@useloyalloop.com

# Server-only Gemini configuration. These values never enter Nuxt runtime config.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=5000
GEMINI_CUSTOMER_TIMEOUT_MS=12000
