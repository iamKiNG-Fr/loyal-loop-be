  @@index([reporterCustomerAccountId, subjectType, createdAt])
  @@index([orderRequestId])
  @@index([saleId])
  @@index([productId])
  @@index([showcaseId])
  @@map("customer_reports")
}

model OrderRequestTermChange {
  id                      String                @id @default(cuid())
  orderRequestId          String
  requestedByUserId       String?
  customerAccountId       String?
  previousFulfillment     FulfillmentType
  previousPaymentMethod   PaymentMethod?
  proposedFulfillment     FulfillmentType?
  proposedPaymentMethod   PaymentMethod?
  resolvedFulfillment     FulfillmentType?
  resolvedPaymentMethod   PaymentMethod?
  reason                  String
  status                  OrderTermChangeStatus @default(PENDING)
  createdAt               DateTime              @default(now())
  resolvedAt              DateTime?
  orderRequest            OrderRequest          @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([orderRequestId, status, createdAt])
  @@map("order_request_term_changes")
}

model CustomerOrderNotice {
  id                String                  @id @default(cuid())
  customerAccountId String
  orderRequestId    String
  type              CustomerOrderNoticeType
  message           String
  dedupeKey         String                  @unique
  actionRequired    Boolean                 @default(false)
  actionResolvedAt  DateTime?
  readAt            DateTime?
  createdAt         DateTime                @default(now())
  customerAccount   CustomerAccount         @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  orderRequest      OrderRequest            @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, readAt, createdAt])
  @@index([orderRequestId, createdAt])
  @@map("customer_order_notices")
}

model OrderRequestShareToken {
  id             String       @id @default(cuid())
  orderRequestId String
  tokenHash      String       @unique
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([orderRequestId, createdAt])
  @@map("order_request_share_tokens")
}

model OrderRequestItem {
  id                String            @id @default(cuid())
  orderRequestId    String
  productId         String?
  variantId         String?
  variantName       String?
  variantSnapshot   Json?
  name              String
  imageUrl          String?
  quantity          Int               @default(1)
  unitPrice         Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  originalUnitPrice Decimal?          @db.Decimal(12, 2)
  promotionId       String?
  promotionSnapshot Json?
  orderRequest      OrderRequest      @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  promotion         ProductPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderRequestId])
  @@index([variantId])
  @@index([promotionId])
  @@map("order_request_items")
}

model OrderRequestPaymentChange {
  id                String         @id @default(cuid())
  orderRequestId    String
  customerAccountId String?
  previousMethod    PaymentMethod?
  nextMethod        PaymentMethod
  createdAt         DateTime       @default(now())
  orderRequest      OrderRequest   @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([orderRequestId, createdAt])
  @@map("order_request_payment_changes")
}

model CommerceEvent {
  id                String            @id @default(cuid())
  businessId        String
  customerAccountId String?
  productId         String?
  showcaseId        String?
  orderRequestId    String?
  type              CommerceEventType
  visitorHash       String?
  sessionKey        String?
  dedupeKey         String?           @unique
  metadata          Json?
  createdAt         DateTime          @default(now())
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerAccount   CustomerAccount?  @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  showcase          Showcase?         @relation(fields: [showcaseId], references: [id], onDelete: SetNull)
  orderRequest      OrderRequest?     @relation(fields: [orderRequestId], references: [id], onDelete: SetNull)

  @@index([businessId, type, createdAt])
  @@index([productId, type])
  @@index([showcaseId, type])
  @@index([customerAccountId, type, createdAt])
  @@map("commerce_events")
}

model DiscoveryPreference {
  id                String           @id @default(cuid())
  businessId        String?
  customerAccountId String?
  visitorHash       String?
  preferences       Json
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, businessId])
  @@unique([visitorHash, businessId])
  @@index([updatedAt])
  @@map("discovery_preferences")
}

model DiscoveryTelemetry {
  id                String           @id @default(cuid())
  customerAccountId String?
  visitorHash       String?
  type              String           @db.VarChar(60)
  value             Float?
  metadata          Json?
  createdAt         DateTime         @default(now())
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([visitorHash, createdAt])
  @@map("discovery_telemetry")
}

model Sale {
  id                 String                  @id @default(cuid())
  businessId         String
  customerId         String
  sourceRequestId    String?                 @unique
  idempotencyKey     String?
  referenceCode      String                  @unique
  status             SaleStatus              @default(COMPLETED)
  paymentStatus      PaymentStatus           @default(UNPAID)
  protectedPayment   Boolean                 @default(false)
  channel            SalesChannel            @default(OTHER)
  fulfillment        FulfillmentType         @default(NOT_REQUIRED)
  currency           String                  @default("NGN")
  subtotal           Decimal                 @default(0) @db.Decimal(12, 2)
  discount           Decimal                 @default(0) @db.Decimal(12, 2)
  deliveryFee        Decimal                 @default(0) @db.Decimal(12, 2)
  total              Decimal                 @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal                 @default(0) @db.Decimal(12, 2)
  notes              String?
  soldAt             DateTime                @default(now())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer                @relation(fields: [customerId], references: [id])
  sourceRequest      OrderRequest?           @relation("RequestConversion", fields: [sourceRequestId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           PaymentEntry[]
  paymentInstruction SalePaymentInstruction?
  paymentProofs      PaymentProof[]
  receipt            Receipt?
  delivery           Delivery?
  activityEvents     ActivityEvent[]
  feedback           CustomerFeedback[]
  issues             CustomerIssue[]
  reports            CustomerReport[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, soldAt])
  @@index([customerId, soldAt])
  @@map("sales")
}

model SalePaymentInstruction {
  id            String        @id @default(cuid())
  saleId        String        @unique
  method        PaymentMethod
  bankName      String?
  bankCode      String?
  accountName   String?
  accountNumber String?
  instructions  String?
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payment_instructions")
}

model SaleItem {
  id                    String   @id @default(cuid())
  saleId                String
  productId             String?
  name                  String
  imageUrl              String?
  quantity              Int      @default(1)
  catalogUnitPrice      Decimal? @db.Decimal(12, 2)
  unitPrice             Decimal  @db.Decimal(12, 2)
  priceAdjustmentReason String?
  total                 Decimal  @db.Decimal(12, 2)
  sale                  Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model PaymentEntry {
  id             String           @id @default(cuid())
  saleId         String
  recordedById   String?
  paymentProofId String?          @unique
  type           PaymentEntryType
  amount         Decimal          @db.Decimal(12, 2)
  note           String?
  reference      String?
  createdAt      DateTime         @default(now())
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recordedBy     User?            @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  paymentProof   PaymentProof?    @relation(fields: [paymentProofId], references: [id], onDelete: SetNull)

  @@index([saleId, createdAt])
  @@map("payment_entries")
}

model PaymentProof {
  id           String             @id @default(cuid())
  businessId   String
  saleId       String
  assetId      String             @unique
  reviewedById String?
  amount       Decimal            @db.Decimal(12, 2)
  reference    String?
  status       PaymentProofStatus @default(SUBMITTED)
  reviewNote   String?
  submittedAt  DateTime           @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale         Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  asset        MediaAsset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reviewedBy   User?              @relation("PaymentProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  paymentEntry PaymentEntry?

  @@index([businessId, status, submittedAt])
  @@index([saleId, submittedAt])
  @@map("payment_proofs")
}

model Receipt {
  id             String              @id @default(cuid())
  businessId     String
  customerId     String
  saleId         String              @unique
  tokenHash      String              @unique
  receiptCode    String              @unique
  status         ReceiptStatus       @default(CREATED)
  theme          ReceiptTheme        @default(CLASSIC_POS)
  note           String?
  footer         String?
  sentAt         DateTime?
  viewedAt       DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id])
  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  activityEvents ActivityEvent[]
  feedback       CustomerFeedback[]
  issues         CustomerIssue[]
  shareTokens    ReceiptShareToken[]
  shortLinks     ShortLink[]

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
  @@map("receipts")
}

model ShortLink {
  id          String        @id @default(cuid())
  code        String        @unique @db.VarChar(8)
  fingerprint String        @unique
  kind        ShortLinkKind
  businessId  String
  productId   String?
  receiptId   String?
  source      String
  campaign    String
  createdAt   DateTime      @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  receipt     Receipt?      @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([expiresAt])
  @@map("short_links")
}

model ReceiptShareToken {
  id        String    @id @default(cuid())
  receiptId String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  receipt   Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId, createdAt])
  @@map("receipt_share_tokens")
}

model Delivery {
  id             String               @id @default(cuid())
  businessId     String
  customerId     String
  saleId         String               @unique
  tokenHash      String               @unique
  status         DeliveryStatus       @default(PREPARING)
  address        String?
  googlePlaceId  String?
  latitude       Float?
  longitude      Float?
  isGift         Boolean              @default(false)
  recipientName  String?
  recipientPhone String?
  courier        String?
  courierService String?
  courierName    String?
  courierPhone   String?
  trackingCode   String?
  trackingUrl    String?
  deliveredAt    DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer             @relation(fields: [customerId], references: [id])
  sale           Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  events         DeliveryEvent[]
  activityEvents ActivityEvent[]
  feedback       CustomerFeedback[]
  issues         CustomerIssue[]
  shareTokens    DeliveryShareToken[]

  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("deliveries")
}

model DeliveryShareToken {
  id         String    @id @default(cuid())
  deliveryId String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  delivery   Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("delivery_share_tokens")
}

model DeliveryEvent {
  id         String         @id @default(cuid())
  deliveryId String
  actorId    String?
  status     DeliveryStatus
  note       String?
  isPublic   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  actor      User?          @relation("DeliveryEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

model ActivityEvent {
  id          String            @id @default(cuid())
  businessId  String
  actorId     String?
  customerId  String?
  saleId      String?
  receiptId   String?
  deliveryId  String?
  type        ActivityEventType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User?             @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale        Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  receipt     Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  delivery    Delivery?         @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  trustEntry  TrustLedgerEntry?

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
  @@index([saleId])
  @@map("activity_events")
}

model FollowUpTemplate {
  id          String               @id @default(cuid())
  businessId  String?
  name        String
  body        String
