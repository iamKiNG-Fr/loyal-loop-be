  OPTIONAL
  ALWAYS_SHOW
  HIDE_BY_DEFAULT
}

enum ShortLinkKind {
  SHOP
  PRODUCT
  RECEIPT
  TRUST_CARD
}

model WaitlistEntry {
  id           Int      @id @default(autoincrement())
  name         String
  businessName String
  email        String   @unique
  refCode      String   @unique
  refBy        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("waitlist")
}

model FoundingAccessApplication {
  id                    String                    @id @default(cuid())
  ownerName             String
  businessName          String
  email                 String                    @unique
  phone                 String?                   @unique
  whatTheySell          String?
  primarySellingChannel String?
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?
  source                FoundingApplicationSource @default(HOMEPAGE)
  status                FoundingApplicationStatus @default(PENDING)
  reviewNotes           String?
  reviewedAt            DateTime?
  reviewedByAdminId     String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  reviewedBy            PlatformAdmin?            @relation("ApplicationReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  invitation            OnboardingInvitation?

  @@index([status, createdAt])
  @@map("founding_access_applications")
}

model FoundingCohort {
  id               String                      @id @default(cuid())
  key              String                      @unique
  name             String
  hypothesis       String?
  status           FoundingCohortStatus        @default(ACTIVE)
  startsAt         DateTime?
  endsAt           DateTime?
  createdByAdminId String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  createdBy        PlatformAdmin               @relation("CohortCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  invitations      OnboardingInvitation[]
  enrollments      FoundingProgramEnrollment[]

  @@index([status, createdAt])
  @@map("founding_cohorts")
}

model OnboardingInvitation {
  id                  String                     @id @default(cuid())
  applicationId       String?                    @unique
  cohortId            String?
  codeHash            String                     @unique
  codeSuffix          String
  encryptedToken      String?
  recipientName       String
  businessName        String
  phone               String
  email               String?
  status              OnboardingInvitationStatus @default(ISSUED)
  expiresAt           DateTime
  maxUses             Int                        @default(1)
  useCount            Int                        @default(0)
  validatedAt         DateTime?
  redeemedAt          DateTime?
  redeemedByUserId    String?
  resultingBusinessId String?                    @unique
  messageOutboxId     String?                    @unique
  createdByAdminId    String
  revokedByAdminId    String?
  revokedAt           DateTime?
  revokeReason        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  application         FoundingAccessApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  cohort              FoundingCohort?            @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  createdBy           PlatformAdmin              @relation("InvitationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  revokedBy           PlatformAdmin?             @relation("InvitationRevoker", fields: [revokedByAdminId], references: [id], onDelete: SetNull)
  messageOutbox       MessageOutbox?             @relation(fields: [messageOutboxId], references: [id], onDelete: SetNull)
  enrollment          FoundingProgramEnrollment?

  @@index([status, expiresAt])
  @@index([phone, status])
  @@index([cohortId, createdAt])
  @@map("onboarding_invitations")
}

model FoundingProgramEnrollment {
  id                    String                      @id @default(cuid())
  businessId            String                      @unique
  invitationId          String                      @unique
  cohortId              String?
  status                FoundingEnrollmentStatus    @default(ONBOARDING)
  invitedAt             DateTime
  onboardedAt           DateTime                    @default(now())
  activatedAt           DateTime?
  weekOneRetainedAt     DateTime?
  weekFourRetainedAt    DateTime?
  complimentaryNoticeAt DateTime?
  complimentaryEndsAt   DateTime?
  exitedAt              DateTime?
  exitReason            String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  business              Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitation            OnboardingInvitation        @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  cohort                FoundingCohort?             @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  interviews            FoundingResearchInterview[]

  @@index([status, activatedAt])
  @@index([cohortId, createdAt])
  @@map("founding_program_enrollments")
}

model FoundingResearchInterview {
  id                       String                    @id @default(cuid())
  enrollmentId             String
  interviewerAdminId       String
  occurredAt               DateTime                  @default(now())
  stage                    String
  mostValuableOutcome      String?
  primaryBlocker           String?
  paidPilotInterest        PaidPilotInterest         @default(NOT_ASKED)
  reasonToPayOrNot         String?
  volunteeredPriceAmount   Decimal?                  @db.Decimal(12, 2)
  volunteeredPriceCurrency String                    @default("NGN")
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  enrollment               FoundingProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  interviewer              PlatformAdmin             @relation("ResearchInterviewer", fields: [interviewerAdminId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, occurredAt])
  @@index([interviewerAdminId, occurredAt])
  @@map("founding_research_interviews")
}

model User {
  id                  String                     @id @default(cuid())
  avatarAssetId       String?                    @unique
  name                String
  email               String                     @unique
  passwordHash        String
  phone               String?                    @unique
  workspaceAppearance WorkspaceAppearance        @default(LIGHT)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  memberships         BusinessMember[]
  ownedBusinesses     Business[]                 @relation("BusinessOwner")
  sessions            OwnerSession[]
  otpChallenges       OwnerOtpChallenge[]
  recoveryTokens      PasswordRecoveryToken[]
  uploadedAssets      MediaAsset[]               @relation("AssetUploader")
  avatarAsset         MediaAsset?                @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  authoredNotes       CustomerNote[]             @relation("NoteAuthor")
  invitationsSent     BusinessInvitation[]       @relation("InvitationSender")
  paymentsRecorded    PaymentEntry[]             @relation("PaymentRecorder")
  paymentProofReviews PaymentProof[]             @relation("PaymentProofReviewer")
  deliveryEvents      DeliveryEvent[]            @relation("DeliveryEventActor")
  activityEvents      ActivityEvent[]            @relation("ActivityActor")
  permissionOverrides MemberPermissionOverride[] @relation("PermissionOverrideActor")
  platformAdmin       PlatformAdmin?
  mediaReviews        MediaModerationReview[]    @relation("MediaReviewActor")

  @@map("users")
}

model PlatformAdmin {
  id                   String                      @id @default(cuid())
  userId               String                      @unique
  role                 PlatformRole
  status               PlatformAdminStatus         @default(ACTIVE)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  lastReviewedAt       DateTime?
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions             PlatformAdminSession[]
  auditLogs            PlatformAdminAuditLog[]
  reviewedApplications FoundingAccessApplication[] @relation("ApplicationReviewer")
  createdCohorts       FoundingCohort[]            @relation("CohortCreator")
  createdInvitations   OnboardingInvitation[]      @relation("InvitationCreator")
  revokedInvitations   OnboardingInvitation[]      @relation("InvitationRevoker")
  researchInterviews   FoundingResearchInterview[] @relation("ResearchInterviewer")
  suspendedBusinesses  Business[]                  @relation("BusinessSuspensionActor")
  reviewedReports      CustomerReport[]             @relation("CustomerReportReviewer")

  @@index([role, status])
  @@map("platform_admins")
}

model PlatformAdminSession {
  id              String        @id @default(cuid())
  platformAdminId String
  ownerSessionId  String
  tokenHash       String        @unique
  verifiedAt      DateTime      @default(now())
  expiresAt       DateTime
  lastUsedAt      DateTime      @default(now())
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  ownerSession    OwnerSession  @relation(fields: [ownerSessionId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, expiresAt])
  @@index([ownerSessionId, revokedAt])
  @@map("platform_admin_sessions")
}

model PlatformAdminAuditLog {
  id           String        @id @default(cuid())
  actorAdminId String
  action       String
  targetType   String
  targetId     String?
  reason       String?
  before       Json?
  after        Json?
  requestId    String?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime      @default(now())
  actor        PlatformAdmin @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([actorAdminId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("platform_admin_audit_logs")
}

model OwnerSession {
  id                    String                 @id @default(cuid())
  userId                String
  tokenHash             String                 @unique
  userAgent             String?
  ipHash                String?
  expiresAt             DateTime
  lastUsedAt            DateTime               @default(now())
  revokedAt             DateTime?
  createdAt             DateTime               @default(now())
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformAdminSessions PlatformAdminSession[]

  @@index([userId, expiresAt])
  @@map("owner_sessions")
}

model OwnerOtpChallenge {
  id                String          @id @default(cuid())
  userId            String?
  phone             String
  provider          String
  providerReference String          @unique
  expiresAt         DateTime
  verifiedAt        DateTime?
  attempts          Int             @default(0)
  purpose           OwnerOtpPurpose @default(LOGIN)
  createdAt         DateTime        @default(now())
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@map("owner_otp_challenges")
}

model PasswordRecoveryToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_recovery_tokens")
}

model Business {
  id                         String                     @id @default(cuid())
  ownerId                    String
  logoAssetId                String?                    @unique
  coverAssetId               String?                    @unique
  name                       String
  slug                       String                     @unique
  publicCardId               String                     @unique
  category                   String?
  categoryDetail             String?
  description                String?
  location                   String?
  storeStatus                StoreStatus                @default(SETTING_UP)
  launchAt                   DateTime?
  launchTimezone             String?
  launchTemplate             LaunchTemplate             @default(SHOP_LOADING)
  launchMessage              String?
  launchProductId            String?
  launchAutoOpen             Boolean                    @default(false)
  launchShareVersion         Int                        @default(1)
  launchedAt                 DateTime?
  pledgeSignature            String?
  pledgedAt                  DateTime?
  plan                       BusinessPlan               @default(PRIVATE_TESTER)
  subscriptionStatus         SubscriptionStatus         @default(INTERNAL_TEST)
  platformStatus             BusinessPlatformStatus     @default(ACTIVE)
  platformSuspendedAt        DateTime?
  platformSuspensionReason   String?
  platformSuspendedByAdminId String?
  isDemo                     Boolean                    @default(false)
  trialStartedAt             DateTime?
  trialEndsAt                DateTime?
  customerLimit              Int?
  receiptLimit               Int?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  owner                      User                       @relation("BusinessOwner", fields: [ownerId], references: [id])
  platformSuspendedBy        PlatformAdmin?             @relation("BusinessSuspensionActor", fields: [platformSuspendedByAdminId], references: [id], onDelete: SetNull)
  logoAsset                  MediaAsset?                @relation("BusinessLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  coverAsset                 MediaAsset?                @relation("BusinessCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  launchProduct              Product?                   @relation("BusinessLaunchProduct", fields: [launchProductId], references: [id], onDelete: SetNull)
  preferences                BusinessPreferences?
  contacts                   BusinessContact[]
  members                    BusinessMember[]
  invitations                BusinessInvitation[]
  assets                     MediaAsset[]               @relation("BusinessAssets")
  customers                  Customer[]
  customerTags               CustomerTag[]
  products                   Product[]
  showcases                  Showcase[]
  shopFollowers              ShopFollow[]
  savedShowcases             SavedShowcase[]
  sales                      Sale[]
  receipts                   Receipt[]
  deliveries                 Delivery[]
  activityEvents             ActivityEvent[]
  followUpTemplates          FollowUpTemplate[]
  followUpSuggestions        FollowUpSuggestion[]
  orderRequests              OrderRequest[]
  wishlistItems              WishlistItem[]
  productInterests           ProductInterest[]
  commerceEvents             CommerceEvent[]
  feedback                   CustomerFeedback[]
  issues                     CustomerIssue[]
  trustLedger                TrustLedgerEntry[]
  supportRequests            SupportRequest[]
  paymentAccounts            BusinessPaymentAccount[]
  paymentProofs              PaymentProof[]
  shortLinks                 ShortLink[]
  categories                 BusinessCategory[]
  customerInsights           CustomerInsightSummary[]
  cartItems                  CustomerCartItem[]
  cartGroups                 CustomerCartGroup[]
  discoveryPreferences       DiscoveryPreference[]
  promotions                 ProductPromotion[]
  messageOutbox              MessageOutbox[]
  customerReports            CustomerReport[]
  foundingEnrollment         FoundingProgramEnrollment?

  @@index([ownerId])
  @@index([storeStatus, launchAt])
  @@index([platformStatus, isDemo, createdAt])
  @@map("businesses")
}

model BusinessPreferences {
  businessId              String              @id
  currency                String              @default("NGN")
  numberFormat            NumberFormat        @default(COMMA_DECIMAL)
  timezone                String              @default("Africa/Lagos")
  theme                   BusinessTheme       @default(LOYAL_PURPLE)
  shelfMode               String              @default("carousel")
  showRecommended         Boolean             @default(true)
  showLatest              Boolean             @default(true)
  tickerItems             String[]            @default(["New drops", "Trusted receipts", "Delivery updates", "Customer favourites"])
  defaultPaymentStatus    PaymentStatus       @default(UNPAID)
  allowedPaymentMethods   PaymentMethod[]     @default([BANK_TRANSFER, PAY_ON_DELIVERY, CASH])
  defaultPaymentMethod    PaymentMethod?
  allowedFulfillmentMethods FulfillmentType[] @default([DELIVERY, PICKUP])
  deliveryAreas           String[]            @default([])
  deliveryStates          String[]            @default([])
  protectedPaymentEnabled Boolean             @default(false)
  receiptDeliveryLine     ReceiptDeliveryLine @default(OPTIONAL)
  receiptFooter           String?
  feedbackResponseTime    String              @default("Within one business day")
  notifyFollowUps         Boolean             @default(true)
  notifyReceiptViews      Boolean             @default(false)
  notifyDeliveryUpdates   Boolean             @default(true)
  exportAccess            ExportAccess        @default(OWNER_ONLY)
  retentionPolicy         RetentionPolicy     @default(MANUAL)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  business                Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_preferences")
}

model BusinessContact {
  id         String          @id @default(cuid())
  businessId String
  platform   ContactPlatform
  value      String
  label      String?
  isPrimary  Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform, value])
  @@index([businessId, sortOrder])
  @@map("business_contacts")
}

model BusinessPaymentAccount {
  id            String   @id @default(cuid())
  businessId    String   @unique
  bankName      String
  bankCode      String?
  accountName   String
  accountNumber String
  instructions  String?
  currency      String   @default("NGN")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_payment_accounts")
}

model BusinessMember {
  id                  String                     @id @default(cuid())
  businessId          String
  userId              String
  role                BusinessRole               @default(VIEWER)
  status              MemberStatus               @default(ACTIVE)
  invitedAt           DateTime?
  joinedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
