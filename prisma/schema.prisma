  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  suggestions FollowUpSuggestion[]

  @@index([businessId])
  @@map("follow_up_templates")
}

model FollowUpSuggestion {
  id          String            @id @default(cuid())
  businessId  String
  customerId  String
  templateId  String?
  reason      String
  status      FollowUpStatus    @default(SUGGESTED)
  dueAt       DateTime?
  approvedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template    FollowUpTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([businessId, status, dueAt])
  @@index([customerId])
  @@map("follow_up_suggestions")
}

model CustomerFeedback {
  id         String    @id @default(cuid())
  businessId String
  customerId String?
  saleId     String
  receiptId  String?
  deliveryId String?
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  receipt    Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@unique([deliveryId])
  @@index([businessId, createdAt])
  @@map("customer_feedback")
}

model CustomerIssue {
  id             String              @id @default(cuid())
  businessId     String
  customerId     String?
  saleId         String
  receiptId      String?
  deliveryId     String?
